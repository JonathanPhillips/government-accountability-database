# Frontend Production Environment Configuration
# Copy this file to .env.production and update with actual values

# API Configuration - Update with production API URL
VITE_API_URL=https://api.govtaccountability.org
VITE_API_VERSION=v1

# Application Settings
VITE_APP_NAME=Government Accountability Database
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_EXPORTS=true

# Google Analytics (Optional)
VITE_GA_TRACKING_ID=G-XXXXXXXXXX
VITE_ENABLE_TRACKING=true

# Sentry Frontend Monitoring
VITE_SENTRY_DSN=https://YOUR_SENTRY_DSN@sentry.io/PROJECT_ID
VITE_SENTRY_ENVIRONMENT=production

# Environment
VITE_ENVIRONMENT=production
