# Application Settings
APP_NAME=GADB
ENVIRONMENT=development
DEBUG=True
API_VERSION=v1
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./gadb.db
# For PostgreSQL (Production): postgresql://user:password@localhost:5432/gadb
# For PostgreSQL (Docker): postgresql://user:password@db:5432/gadb
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis (for Celery and Caching)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300
CACHE_ENABLED=True

# API Keys
ANTHROPIC_API_KEY=your_api_key_here

# JWT Authentication
SECRET_KEY=your-secret-key-here-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1

# Security Settings
SECURE_COOKIES=False
HTTPS_ONLY=False
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_FORMAT=json
LOG_TO_CONSOLE=True

# Email Configuration (Optional)
SMTP_ENABLED=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@govtaccountability.org
SMTP_TLS=True

# Monitoring (Optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEW_RELIC_LICENSE_KEY=

# Wayback Machine
WAYBACK_MACHINE_API=https://archive.org/wayback/available

# File Upload (if needed)
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=uploads

# Celery (Background Tasks)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Feature Flags
ENABLE_ANALYTICS=True
ENABLE_EXPORTS=True
ENABLE_EMAIL_NOTIFICATIONS=False
