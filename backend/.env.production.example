# Production Environment Configuration
# Copy this file to .env in production and update with actual values

# Application Settings
APP_NAME=GADB
ENVIRONMENT=production
DEBUG=False
API_VERSION=v1
HOST=0.0.0.0
PORT=8000

# Database - PostgreSQL Required for Production
DATABASE_URL=postgresql://gadb_user:CHANGE_ME_STRONG_PASSWORD@db:5432/gadb_prod
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Redis - Required for Production
REDIS_URL=redis://redis:6379/0
CACHE_TTL=600
CACHE_ENABLED=True

# API Keys - Update with actual values
ANTHROPIC_API_KEY=sk-ant-YOUR_ACTUAL_API_KEY_HERE

# JWT Authentication - MUST CHANGE IN PRODUCTION
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_USE_OPENSSL_RAND_HEX_32_TO_GENERATE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration - Update with actual frontend domains
CORS_ORIGINS=https://govtaccountability.org,https://www.govtaccountability.org
ALLOWED_HOSTS=govtaccountability.org,www.govtaccountability.org,api.govtaccountability.org

# Security Settings - Production Hardening
SECURE_COOKIES=True
HTTPS_ONLY=True
BCRYPT_ROUNDS=12

# Rate Limiting - Strict for Production
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=500

# Logging - Production Settings
LOG_LEVEL=WARNING
LOG_FILE=/var/log/gadb/app.log
LOG_FORMAT=json
LOG_TO_CONSOLE=False

# Email Configuration - Configure for notifications
SMTP_ENABLED=True
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@govtaccountability.org
SMTP_PASSWORD=CHANGE_ME_USE_APP_PASSWORD
SMTP_FROM=noreply@govtaccountability.org
SMTP_TLS=True

# Monitoring - Enable for Production
SENTRY_DSN=https://YOUR_SENTRY_DSN@sentry.io/PROJECT_ID
SENTRY_ENVIRONMENT=production
NEW_RELIC_LICENSE_KEY=YOUR_NEW_RELIC_LICENSE_KEY

# Wayback Machine
WAYBACK_MACHINE_API=https://archive.org/wayback/available

# File Upload
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=/var/uploads/gadb

# Celery - Background Tasks
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Feature Flags
ENABLE_ANALYTICS=True
ENABLE_EXPORTS=True
ENABLE_EMAIL_NOTIFICATIONS=True

# Backup Configuration
BACKUP_ENABLED=True
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
S3_BACKUP_BUCKET=gadb-backups
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_REGION=us-east-1
